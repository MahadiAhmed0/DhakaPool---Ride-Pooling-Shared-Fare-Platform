{
  "name": "@dhakapool/api",
  "version": "0.1.0",
  "private": true,
  "description": "Dhaka Tesla Pool REST API (Express + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@dhakapool/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15"
  }
}
