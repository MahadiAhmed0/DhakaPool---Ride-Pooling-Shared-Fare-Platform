# Dhaka Tesla Pool — environment variables (ARCHITECTURE §12.3).
# Copy to `.env` for local development. Docker Compose also works without a .env file (it uses these defaults).
# Placeholder values only — never commit real secrets (NFR-SEC-05).

# --- Database (used by the db container and by local development) ---
POSTGRES_USER=dhakapool
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dhakapool
# Host port for PostgreSQL; change it if 5432 is already used on your machine.
DB_PORT=5432

# URLs for running the API on your machine (outside Docker). Docker Compose sets its own internal URLs.
DATABASE_URL=postgresql://dhakapool:change-me@localhost:5432/dhakapool
DIRECT_URL=postgresql://dhakapool:change-me@localhost:5432/dhakapool
TEST_DATABASE_URL=postgresql://dhakapool:change-me@localhost:5432/dhakapool_test

# --- API ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Sessions (ADR-0005): lifetime in hours; set COOKIE_SECURE=true when served over HTTPS.
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
# Password hashing cost (bcrypt). Lower values only make tests faster; keep 12 elsewhere.
BCRYPT_COST=12
# Demo-only password for every seeded persona (documented in the README; not a secret).
# Keep the quotes: without them Node and dotenv read everything after "#" as a comment.
SEED_DEMO_PASSWORD="TeslaPool#2026"

# --- Web ---
# Where the web app's /api proxy sends requests (baked in at build time).
API_INTERNAL_URL=http://localhost:4000

# --- Business rules (SRS BR-11, BR-07, A-13, BR-02, FR-DRV-12) ---
FARE_BASE_PAISA=3000
FARE_PER_KM_PAISA=1500
FARE_POOL_DISCOUNT_BPS=2000
CANCELLATION_FEE_PAISA=2000
REQUEST_EXPIRY_MINUTES=15
POOL_JOIN_WINDOW_MINUTES=10
NO_SHOW_WAIT_MINUTES=5
